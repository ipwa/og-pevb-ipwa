<div class="container-wide w-full pb-8 md:pb-10">
  <h2 class="mb-4 text-4xl font-headers font-extrabold leading-none tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">
    {{ headline }}
  </h2>

  {% if button %}
    <p class="mb-6 text-lg">
      {% for key, btn in button %}
        <a href="{{ btn.url }}" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
          {{ btn.title }}
        </a>
        {% if not loop.last %} or {% endif %}
      {% endfor %}
    </p>
  {% endif %}

  <p class="mb-6 text-sm text-gray-600">
    {{ message }}
  </p>
</div>
